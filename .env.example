APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/contextops.db
AI_PROVIDER=deterministic

# Required administrator credentials. Replace both placeholders in a secret
# store or a local, ignored .env file. Do not commit real credentials.
CONTEXTOPS_ADMIN_USERNAME=replace_with_admin_username
CONTEXTOPS_ADMIN_PASSWORD=replace_with_a_long_random_password
CONTEXTOPS_COOKIE_SECURE=false
CONTEXTOPS_SESSION_TTL_SECONDS=28800
